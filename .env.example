# Konfigurasi Aplikasi SaaS
SECRET_KEY=ubah_dengan_string_random_yang_panjang_dan_aman
PORT=5000
DEBUG=True

# Konfigurasi Pakasir Payment Gateway (Daftar di https://pakasir.id)
PAKASIR_SLUG=nama_proyek_anda_di_pakasir
PAKASIR_API_KEY=api_key_rahasia_dari_dashboard_pakasir
PAKASIR_BASE_URL=https://app.pakasir.com/pay

# URL Publik Aplikasi (Untuk redirect & webhook callback)
APP_URL=http://localhost:5000
